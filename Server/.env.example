# Copy this file to .env and fill in your real values. Never commit .env.

MONGO_URI=
JWT_SECRET=
AIStudio_API_KEY=
PORT=5000

# Required for forgot-password OTP emails. Without these the server answers
# "Email service is not configured". For Gmail, SMTP_PASS must be an App Password.
# Render's free plan blocks outbound SMTP ports 25, 465 and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
